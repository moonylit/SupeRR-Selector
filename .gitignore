# Python bytecode and test/lint caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# Local data: never commit source datasets or derived delivery-level data
data/raw/
data/processed/

# Generated analysis artifacts (commit selected final deliverables deliberately)
outputs/figures/*
outputs/reports/*
outputs/rankings/*
outputs/processed/*
!outputs/figures/.gitkeep
!outputs/reports/.gitkeep
!outputs/rankings/.gitkeep
!outputs/processed/.gitkeep

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db