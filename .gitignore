# Python bytecode and test/lint caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
tmp/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# Local data: never commit source datasets or derived delivery-level data
data/raw/
data/processed/

# Intermediate processed data and unreviewed player rankings stay local
outputs/rankings/*
outputs/processed/*
!outputs/rankings/.gitkeep
!outputs/processed/.gitkeep
outputs/reports/final_strategy*
outputs/figures/final_strategy/
outputs/submission/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
